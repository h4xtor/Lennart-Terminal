{
  "name": "lennart-terminal",
  "productName": "Lennart Terminal",
  "version": "0.4.2",
  "description": "A Warp.dev-style terminal for Windows with an integrated local AI agent",
  "main": "src/main/main.js",
  "author": "Lennart",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "test": "node test/run-all.js",
    "check": "node scripts/check.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --x64 --publish never",
    "store": "electron-builder --win appx --x64 --publish never --config electron-builder.store.js"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "@xterm/xterm": "^6.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-search": "^0.16.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.lennart.terminal",
    "productName": "Lennart Terminal",
    "copyright": "MIT — Lennart",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "electronLanguages": [
      "en-US",
      "en-GB",
      "da"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "LennartTerminal-${version}-win-x64.${ext}",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "LennartTerminal-${version}-portable.exe"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "node-pty@1.1.0": true
  }
}
