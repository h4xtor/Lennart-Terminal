{
  "name": "lennart-terminal",
  "productName": "Lennart Terminal",
  "version": "0.1.0",
  "description": "A Warp.dev-style terminal for Windows with an integrated local AI agent",
  "main": "src/main/main.js",
  "author": "Lennart",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "test": "node test/ai.test.js",
    "check": "node scripts/check.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "@xterm/xterm": "^6.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-search": "^0.16.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.lennart.terminal",
    "productName": "Lennart Terminal",
    "files": [
      "src/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "node-pty@1.1.0": true
  }
}
